{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "build/server",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src/server", "src/shared"]
}
