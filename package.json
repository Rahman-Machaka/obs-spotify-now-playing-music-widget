{
  "name": "obs-music-widget",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/server/index.js start",
    "stop": "node build/server/server/index.js stop",
    "status": "node build/server/server/index.js status",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:smoke",
    "test:unit": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "docs:capture": "node scripts/capture-readme-assets.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@primno/dpapi": "^2.0.1",
    "fastify": "^5.6.0",
    "preact": "^10.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0"
  }
}
